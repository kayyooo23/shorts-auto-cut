DATABASE_URL=sqlite:///./storage/app.db
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu

DEFAULT_MOMENTS_COUNT=6

# сгенерируй свой: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
FORGOT_PASSWORD_RATE_LIMIT=3/minute
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# сгенерируй свой: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ОТДЕЛЬНЫЙ от SECRET_KEY. Обязателен при ENVIRONMENT=production.
TOKEN_ENCRYPTION_KEY=

ENVIRONMENT=development
CORS_ORIGINS=*
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute

# Задай ОДИН РАЗ, чтобы создать единственный админ-аккаунт — публичной формы
# регистрации для админа нет намеренно. При каждом старте приложение
# гарантирует, что пользователь с этим email существует и is_admin=True
# (см. main.py::_bootstrap_admin_account). Логин — обычный POST /auth/login
# этим же email/паролем. Можно закомментировать/удалить после первого
# создания аккаунта — на уже созданный админ-аккаунт это не повлияет.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-to-a-strong-password

# "celery" — облачный SaaS-режим, задачи через Redis+Celery worker (нужен Docker).
# "local"  — desktop-режим, задачи выполняются в потоках внутри процесса,
#            Redis/Celery/Docker не нужны вообще. См. app/job_runner.py.
RUNNER_MODE=celery

# --- Публикация на платформы ---
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# YouTube включён по умолчанию — работает сразу после получения ключей.
# TikTok/Instagram выключены по умолчанию, см. README про их ограничения.
PLATFORM_YOUTUBE_ENABLED=true
PLATFORM_TIKTOK_ENABLED=false
PLATFORM_INSTAGRAM_ENABLED=false

# Google Cloud Console -> OAuth 2.0 Client ID (тип Web application)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok for Developers -> Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers -> Facebook Login + Instagram Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Публичный URL, откуда Instagram сможет скачать готовый рендер (S3/аналог)
PUBLIC_STORAGE_BASE_URL=

# --- Тарифы и монеты ---
MAX_VIDEO_DURATION_SECONDS=1800
EXTRA_CUT_COST_COINS=50
EXTRA_ACCOUNT_SLOT_COST_COINS=200

# Секрет для проверки вебхуков платёжного провайдера — сгенерируй свой:
# python3 -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=
